# -----------------------------------------------------------------------------
# Data-Recording – Environment Configuration
# -----------------------------------------------------------------------------

# General Application Settings
APP_NAME=data-recorder
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=9015
LOG_LEVEL=INFO

# MySQL Database Settings (Synology NAS / Local)
DB_HOST=192.168.2.125
DB_PORT=3306
DB_USER=recorder
DB_PASSWORD=your_secure_password_here
DB_NAME_VERBRAUCH=verbrauch
DB_NAME_WERTPAPIERE=wertpapiere
DB_NAME_HIBISCUS=hibiscus
# Kommagetrennte Liste von Kontonummern/IBANs fuer Hibiscus-Scan (optional)
HIBISCUS_ACCOUNT_FILTERS=

# External Integrations
# Vaillant aroTHERM plus ebusd Daemon
EBUSD_URL=http://192.168.2.125:58888/data

# Paperless-ngx Document Archive
PAPERLESS_API_URL=http://192.168.2.125:8000
PAPERLESS_API_TOKEN=your_paperless_token_here
PAPERLESS_TAG=Zaehlerbeleg
PAPERLESS_DOCUMENT_TYPE=Zaehlerbeleg
FAILED_UPLOADS_DIR=data/failed_uploads

# Heizöl-Scraper (PLZ 90579 Langenzenn, 2500L)
HEIZOEL_PLZ=90579
HEIZOEL_MENGE_LITER=2500
HEIZOEL_PROVIDER_URL=https://www.esyoil.com/heizoelpreise/heizoel-bestellung
HEIZOEL_SCRAPER_TIMEOUT=15.0

